<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:background="@drawable/bg_widget_pill"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- Plus / Add Icon Badge (Matching the App's '+' button) -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_widget_cash_badge">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="@string/widget_quick_cash_title" />
    </FrameLayout>

    <!-- Center Text (Clickable quick entry) -->
    <LinearLayout
        android:id="@+id/btn_text_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_cash_title"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_cash_hint"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Type / Edit Button -->
    <ImageButton
        android:id="@+id/btn_edit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_widget_edit"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_quick_cash_type_desc" />

    <!-- Mic Button (Voice entry trigger) -->
    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_widget_mic_btn"
        android:src="@drawable/ic_widget_mic"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_quick_cash_voice_desc" />

</LinearLayout>
