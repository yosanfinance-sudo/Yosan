# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Google OAuth Credentials
GOOGLE_WEB_CLIENT_ID=1090000000000-example.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=1090000000000-androidexample.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# OAuth 2.0 Server Configuration

# Session JWT Secrets
JWT_SECRET=replace_with_secure_random_jwt_secret_key
JWT_REFRESH_SECRET=replace_with_secure_random_jwt_refresh_secret_key

# Backend Server Configuration
PORT=3000
NODE_ENV=development
DB_PATH=./server/finance_manager.db

# --------------------------------------------------------------------------
# Email OTP SMTP Configuration (Send OTP from any Company / Gmail address)
# --------------------------------------------------------------------------
# Option A: Gmail / Google Workspace Company Email:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate an "App Password" (16 characters)
# SMTP_SERVICE=gmail
# SMTP_USER=your_company_email@company.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM=Yosan Finance <your_company_email@company.com>

# Option B: Custom Company Domain (Zoho, Hostinger, Outlook, AWS SES):
# SMTP_HOST=smtp.gmail.com (or smtp.zoho.com / smtp.office365.com / smtp.hostinger.com)
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@yourcompany.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Yosan Finance <noreply@yourcompany.com>
